<section class="bg-gray-50 dark:bg-gray-900">
  <div class="flex flex-col items-center justify-center px-6 py-8 mx-auto md:h-screen lg:py-0">
    <div
      class="w-full bg-white rounded-lg shadow dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700">
      <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
        <div class="flex items-center mb-6 text-primary-600 w-full justify-center">
          {{> icons/logo width="100" height="100"}}
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-300">Étape 2 sur 2</p>
        <h1 class="text-xl font-bold text-gray-900 dark:text-white">Vérifiez votre identité</h1>
        <p class="text-sm text-gray-600 dark:text-gray-300">Saisissez le code à 6 chiffres de votre application d’authentification.</p>
        <form method="POST" action="/auth/two-factor" class="space-y-4 md:space-y-6">
          <div>
            <label for="code" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Code de vérification</label>
            <input type="text" name="code" id="code" autocomplete="one-time-code" autocapitalize="none" spellcheck="false" maxlength="64" aria-describedby="code-hint" required
              class="bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
            <p id="code-hint" class="mt-2 text-sm text-gray-600 dark:text-gray-300">Vous pouvez aussi utiliser l’un de vos codes de récupération à usage unique.</p>
          </div>

          {{#if flashMessage}}
          <div class="mb-4">
            {{> alerts/error title=flashMessage.title content=flashMessage.content}}
          </div>
          {{/if}}

          <button type="submit"
            class="w-full text-white bg-primary-600 hover:bg-primary-700 focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">Vérifier et se connecter</button>
          <p class="text-sm text-gray-600 dark:text-gray-300"><a href="/auth/login" class="text-primary-600 hover:underline">Recommencer la connexion</a></p>
          <p class="text-sm text-gray-600 dark:text-gray-300">Vous avez perdu votre application et vos codes de récupération ? Contactez l’administration.</p>
        </form>
      </div>
    </div>
  </div>
</section>
