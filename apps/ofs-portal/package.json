{
  "name": "@boris/ofs-portal",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^26.0.0",
    "npm": "11.14.1"
  },
  "scripts": {
    "start:dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "start": "node build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "generate-api-types": "openapi-typescript http://localhost:3000/api/documentation/schema/json --output src/lib/types/generated-api-types.ts"
  },
  "devDependencies": {
    "@gouvfr/dsfr": "^1.14.2",
    "@playwright/test": "1.61.1",
    "@sveltejs/adapter-node": "^5.5.8",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/qrcode": "^1.5.6",
    "eslint-plugin-svelte": "^2.36.0",
    "openapi-typescript": "^7.8.0",
    "prettier-plugin-svelte": "^3.1.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.0.0",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
